{
  "name": "ctdp-desktop",
  "productName": "CTDP",
  "version": "0.1.0",
  "description": "CTDP 链式时延协议的桌面工具：神圣座位、下必为例、预约",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "icons": "python3 scripts/make-icons.py",
    "dist:win": "npm run build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
