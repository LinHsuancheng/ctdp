{
  "name": "ctdp-desktop",
  "productName": "CTDP",
  "version": "0.1.0",
  "description": "CTDP \u94fe\u5f0f\u65f6\u5ef6\u534f\u8bae\u7684\u684c\u9762\u5de5\u5177\uff1a\u795e\u5723\u5ea7\u4f4d\u3001\u4e0b\u5fc5\u4e3a\u4f8b\u3001\u9884\u7ea6",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "smoke": "npm run build && npm run build:server && bash scripts/smoke.sh",
    "icons": "python3 scripts/make-icons.py",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "build:server": "npm --prefix server run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
