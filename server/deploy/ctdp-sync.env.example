# Copy to /etc/ctdp-sync.env (chmod 600). Every device enters this token.
CTDP_TOKEN=replace-with-output-of-openssl-rand-hex-32
CTDP_DATA_DIR=/var/lib/ctdp-sync
HOST=127.0.0.1
PORT=8787
# Push services need a real contact: your https address or a mailto: you read.
VAPID_SUBJECT=https://your-subdomain.example.org
# The phone web app; defaults to <repo>/dist/web next to server/.
# STATIC_DIR=/opt/ctdp/dist/web
